{
  "schema": 2,
  "tasks": [
    {
      "id": "folder-clock-home",
      "description": "Open productivity folder, enter Clock, return and close folder",
      "setup": [
        {
          "op": "home"
        }
      ],
      "ready": {
        "app": "com.apple.springboard",
        "selector": {
          "kind": "Icon",
          "label": "productivity folder"
        }
      },
      "phases": [
        {
          "goal": "Open the productivity folder, then open Clock inside it.",
          "apps": [
            "com.apple.springboard",
            "com.apple.mobiletimer"
          ],
          "until": {
            "app": "com.apple.mobiletimer"
          }
        },
        {
          "goal": "Press Home to exit the current app and return to the Home Screen.",
          "apps": [
            "com.apple.springboard",
            "com.apple.mobiletimer"
          ],
          "allow_home": true,
          "until": {
            "app": "com.apple.springboard"
          }
        },
        {
          "goal": "Close the currently open folder.",
          "apps": [
            "com.apple.springboard"
          ],
          "allow_home": true,
          "until": {
            "app": "com.apple.springboard",
            "absent": {
              "kind": "TextField",
              "label": "productivity, Folder name"
            }
          }
        }
      ],
      "verify": {
        "app": "com.apple.springboard",
        "absent": {
          "kind": "TextField",
          "label": "productivity, Folder name"
        }
      }
    },

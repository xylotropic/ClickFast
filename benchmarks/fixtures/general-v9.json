    {
      "id": "tiktok-open",
      "description": "Home to TikTok, app launch and visible result included",
      "setup": [
        {
          "op": "home"
        }
      ],
      "phases": [
        {
          "goal": "Open TikTok from the Home Screen.",
          "apps": [
            "com.apple.springboard",
            "com.zhiliaoapp.musically"
          ],
          "visible_controls": true,
          "launch_apps": [
            {
              "label": "TikTok",
              "bundle": "com.zhiliaoapp.musically"
            }
          ],
          "until": {
            "app": "com.zhiliaoapp.musically"
          }
        }
      ],
      "verify": {
        "app": "com.zhiliaoapp.musically"
      },
      "min_actions": 1,
      "require_controls": true,
      "verify_ocr": {
        "any": [
          {
            "min_lines": 5,
            "all": [
              [
                "For You"
              ],
              [
                "Following"
              ],
              [
                "Profile"
              ]
            ]
          },
          {
            "min_lines": 3,
            "all": [
              [
                "TikTok"
              ],
              [
                "Skip ad"
              ]
            ]
          }
        ]
      },
      "verify_timeout_ms": 8000
    },
    {
      "id": "tiktok-scroll",
      "description": "Home to TikTok and scroll once; independently check changed feed content",
      "setup": [
        {
          "op": "home"
        }
      ],
      "phases": [
        {
          "goal": "Open TikTok from the Home Screen.",
          "apps": [
            "com.apple.springboard",
            "com.zhiliaoapp.musically"
          ],
          "visible_controls": true,
          "launch_apps": [
            {
              "label": "TikTok",
              "bundle": "com.zhiliaoapp.musically"
            }
          ],
          "until": {
            "app": "com.zhiliaoapp.musically"
          }
        },
        {
          "goal": "Tap Skip ad.",
          "apps": [
            "com.zhiliaoapp.musically"
          ],
          "visual_target": {
            "text": "Skip ad",
            "if_present": true
          },
          "external_ui_opt_in": true
        },
        {
          "goal": "Tap Home.",
          "apps": [
            "com.zhiliaoapp.musically"
          ],
          "visual_target": {
            "text": "Home",
            "bottom": true
          },
          "until_ocr": {
            "min_lines": 5,
            "all": [
              [
                "For You"
              ],
              [
                "Following"
              ],
              [
                "Profile"
              ]
            ]
          },
          "external_ui_opt_in": true
        },
        {
          "goal": "Scroll up once in the observed feed.",
          "apps": [
            "com.zhiliaoapp.musically"
          ],
          "until": {
            "app": "com.zhiliaoapp.musically",
            "after_action": {
              "kind": "SystemAction",
              "label": "Swipe up"
            }
          },
          "action": {
            "op": "swipe",
            "direction": "up"
          },
          "precondition_ocr": {
            "min_lines": 5,
            "all": [
              [
                "For You"
              ],
              [
                "Following"
              ]
            ]
          }
        }
      ],
      "verify": {
        "app": "com.zhiliaoapp.musically"

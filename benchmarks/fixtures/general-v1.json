    {
      "id": "contacts-text",
      "description": "Type a controlled multiword search in Contacts, without creating or editing a contact",
      "setup": [
        {
          "op": "launch",
          "bundle": "com.apple.MobileAddressBook"
        }
      ],
      "phases": [
        {
          "goal": "Enter the exact provided query into the Contacts search field. Do not create or edit a contact.",
          "apps": [
            "com.apple.MobileAddressBook"
          ],
          "allowed_selectors": [
            {
              "kind": "SearchField",
              "label": "Search"
            },
            {
              "kind": "Button",
              "label": "Cancel"
            },
            {
              "kind": "Button",
              "label": "Lists"
            }
          ],
          "texts": {
            "query": "Operator Jane Doe 27"
          },
          "until": {
            "app": "com.apple.MobileAddressBook",
            "selector": {
              "kind": "SearchField",
              "value": "Operator Jane Doe 27"
            }
          }
        }
      ],
      "verify": {
        "app": "com.apple.MobileAddressBook",
        "selector": {
          "kind": "SearchField",
          "value": "Operator Jane Doe 27"
        }
      },
      "cleanup": [
        {
          "op": "tap",
          "selector": {
            "kind": "Button",
            "label": "Clear text"
          }
        }
      ],
      "reset_text": {
        "selector": {
          "kind": "SearchField",
          "label": "Search"
        },
        "owned_values": [
          "Operator Jane Doe 27"
        ]
      }
    },
    {
      "id": "shortcuts-gallery",
